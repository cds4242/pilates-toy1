<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ── 콘솔 출력 (12-Factor App §XI: 모든 환경에서 stdout 단일화, D-011) ── -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ── JSON 콘솔 출력 (운영용 구조화 로그) ── -->
    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <timeZone>Asia/Seoul</timeZone>
        </encoder>
    </appender>

    <!-- ── 로컬 프로파일: 사람이 읽기 쉬운 패턴 ── -->
    <springProfile name="local">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="com.pilates" level="DEBUG"/>
        <logger name="org.hibernate.SQL" level="DEBUG"/>
        <logger name="org.hibernate.orm.jdbc.bind" level="TRACE"/>
    </springProfile>

    <!-- ── 운영 프로파일: 구조화 JSON으로 stdout 출력 ── -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE_JSON"/>
        </root>
        <logger name="com.pilates" level="INFO"/>
    </springProfile>

    <!-- ── 기본 (dev 등): 사람 친화 콘솔 ── -->
    <springProfile name="!local,!prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="com.pilates" level="DEBUG"/>
    </springProfile>

</configuration>
