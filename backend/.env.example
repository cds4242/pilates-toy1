# 암호화 키 (AES-256, Base64 인코딩된 32바이트)
# 생성 명령: openssl rand -base64 32
ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# JWT 시크릿 (HS256, Base64 인코딩된 32바이트 이상)
# 생성 명령: openssl rand -base64 32
JWT_SECRET=your-base64-encoded-jwt-secret

# MySQL (Docker Compose 기본값과 동일)
MYSQL_ROOT_PASSWORD=root1234
MYSQL_DATABASE=pilates
MYSQL_USER=pilates
MYSQL_PASSWORD=pilates1234
