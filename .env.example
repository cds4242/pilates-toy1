# ============================================
# Pilates Studio - 운영 환경변수
# 이 파일을 .env로 복사 후 실제 값 입력
# ============================================

# ── Database (MySQL) ──
DB_ROOT_PASSWORD=change_me_root
DB_NAME=pilates
DB_USER=pilates
DB_PASSWORD=change_me_db_password
DB_PORT=3306

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379

# ── JWT ──
# 최소 256bit (32자) 이상, Base64 인코딩
# 생성: openssl rand -base64 32
JWT_SECRET=change_me_jwt_secret_base64_encoded

# ── AES-256 암호화 (회원 개인정보) ──
# 32바이트 키, Base64 인코딩
# 생성: openssl rand -base64 32
ENCRYPTION_KEY=change_me_aes_key_base64_encoded
ENCRYPTION_KEY_VERSION=v1

# ── 토스페이먼츠 ──
# https://developers.tosspayments.com
TOSS_SECRET_KEY=test_sk_DUMMY

# ── Frontend 빌드 시점 (NEXT_PUBLIC_*) ──
# 브라우저가 호출할 backend 공개 URL — 빌드 시점에 JS 번들에 박힘
# 로컬: http://localhost:8080
# Railway: https://your-backend.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:8080

# ── CORS ──
# 프론트엔드 도메인 (콤마 구분)
CORS_ALLOWED_ORIGINS=https://your-domain.com

# ── 카카오 알림톡 (NHN Toast) ──
ALIMTALK_SENDER_KEY=your_sender_key
ALIMTALK_PFID=@your_plus_friend_id

# ── SMS (NHN Toast) ──
# SMS_API_KEY=your_sms_api_key

# ── 초기 관리자 ──
# BCrypt strength 12 해시
# 생성: Java BCryptPasswordEncoder(12).encode("your_password")
# INITIAL_ADMIN_LOGIN_ID=admin
# INITIAL_ADMIN_PASSWORD_HASH=$2a$12$...
